{
  "name": "backseat-whatsapp-outreach",
  "version": "1.0.0",
  "description": "Backseat Network WhatsApp advertiser outreach backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/basic-auth": "6.0.3",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "9.0.3",
    "@prisma/client": "6.5.0",
    "bullmq": "5.41.0",
    "csv-parse": "5.6.0",
    "fastify": "5.2.1",
    "ioredis": "5.5.0",
    "libphonenumber-js": "1.11.20",
    "pino": "9.6.0",
    "prisma": "6.5.0",
    "telegraf": "4.16.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "pino-pretty": "13.0.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  }
}
