# Application
APP_PORT=3000
# From outside Docker use http://localhost:3000.
# Inside Compose, Evolution should call the backend service for webhooks:
APP_BASE_URL=http://backend:3000
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=change-me-to-a-strong-password
# Browser origins allowed to call the API (comma-separated). * for demos only.
CORS_ORIGIN=*
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL (used by docker-compose for the app database)
POSTGRES_USER=outreach
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=outreach
DATABASE_URL=postgresql://outreach:change-me-strong-db-password@postgres:5432/outreach?schema=public

# Redis
REDIS_URL=redis://redis:6379/0

# Evolution API (WhatsApp Web via Baileys — free/open-source, no per-message Meta Cloud fees)
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=change-me-generate-a-32-char-hex-key
EVOLUTION_INSTANCE_NAME=backseat-outreach
WHATSAPP_WEBHOOK_SECRET=change-me-webhook-shared-secret
# Bind Evolution manager/Swagger to localhost by default (safer than 0.0.0.0).
# Use 8080 to publish on all interfaces, or leave as 127.0.0.1:8080 for SSH tunnel only.
EVOLUTION_PORT=127.0.0.1:8080
EVOLUTION_SERVER_URL=http://127.0.0.1:8080

# Telegram notifications (optional — disabled gracefully if empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini (optional personalization). Leave empty to use static MESSAGE_TEMPLATE only.
# Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MESSAGE_GENERATION=false

# Deprecated — ignored (kept for older .env files)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Outreach operational safeguards (founder: ~30–50/day, random 30–60s gaps)
TIMEZONE=Asia/Kolkata
DAILY_MESSAGE_LIMIT=35
MIN_MESSAGE_DELAY_SECONDS=30
MAX_MESSAGE_DELAY_SECONDS=60
SENDING_WINDOW_START=10:00
SENDING_WINDOW_END=18:30
SENDING_DAYS=1,2,3,4,5,6
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE
MESSAGE_TEMPLATE=Hi {{contact_person_or_business_name}} team, we came across your business in {{locality}}.\n\nBackseat Network offers in-cab advertising opportunities across Delhi NCR. Would you be interested in learning more?\n\nReply STOP if you do not wish to receive further messages.
DEFAULT_PHONE_COUNTRY=IN
